{
  "name": "apsara-hosting",
  "version": "1.0.0",
  "description": "Apsara Cloud & Game Hosting Platform",
  "main": "server.js",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "postinstall": "npm install --prefix client",
    "build": "npm install --prefix client && npm run build --prefix client",
    "client:dev": "npm run dev --prefix client"
  },
  "keywords": [
    "hosting",
    "telegram-bot",
    "discord-bot",
    "game-server",
    "minecraft"
  ],
  "author": "",
